# Copy this file to .env.local and set each value in your local secret store.
# Never commit .env.local or place production values in this file.

# CockroachDB connection string for dashboard data access.
DATABASE_URL=

# Single deploy-time console owner credentials. `ADMIN_PASSWORD_HASH` uses
# `pbkdf2-sha256$iterations$salt$hash`; do not configure a plaintext password.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=

# Google OAuth & Admin Authorization
# ADMIN_EMAILS is a comma-separated list of allowed admin email addresses
ADMIN_EMAILS="admin@example.com,user@example.com"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=https://your-domain.amplifyapp.com
AUTH_URL=https://your-domain.amplifyapp.com

# Public URL of the canonical FastMCP server. Do not expose its bearer token.
NEXT_PUBLIC_MCP_SERVER_URL=
MCP_SERVER_URL=

# Server-only token used by authenticated dashboard routes to query FastMCP health.
HIVE_CONTEXT_SERVER_TOKEN=